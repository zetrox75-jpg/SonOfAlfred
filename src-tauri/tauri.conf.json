{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AION 2 Craft Profit Manager",
  "version": "0.1.2",
  "identifier": "com.aion2.craftprofitmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AION 2 Craft Profit Manager",
        "width": 1366,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https://gamers4.life; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCRjZFMjI1MUVFNEFBNjIKUldSaXF1UWVKZUwyTy90ZVNONmZWYU9LNWF0c3djUGY0bHdMeGpmK3BXQmtNZnlJRkJ3aDJwdm0K",
      "endpoints": [
        "https://github.com/zetrox75-jpg/SonOfAlfred/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
